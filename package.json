{
  "name": "hl7-tstd",
  "version": "1.1.0-beta.0",
  "description": "A simple lightweight package to create, parse & transform HL7 message.",
  "keywords": [
    "create",
    "format",
    "hl7",
    "hl7-tstd",
    "parse",
    "standard",
    "transform"
  ],
  "homepage": "https://github.com/1nandagopal/hl7-tstd#readme",
  "bugs": {
    "url": "https://github.com/1nandagopal/hl7-tstd/issues"
  },
  "license": "Apache-2.0",
  "author": "1nandagopal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1nandagopal/hl7-tstd.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": ">=10.0.0"
  }
}
